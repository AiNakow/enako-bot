# 将这些配置合并到机器人实际加载的 .env.prod / .env.dev。
# 不要用本文件覆盖机器人已有环境文件。
# 本文件不会自动加载；NoneBot 字段名大小写不敏感。
PEOPLE_COUNTER_APP_KEY=
PEOPLE_COUNTER_APP_SECRET=
PEOPLE_COUNTER_ACCESS_TOKEN=
PEOPLE_COUNTER_DEVICE_SERIAL=
PEOPLE_COUNTER_CHANNEL_NO=1

# 以下路径相对于 nonebot_people_counter/，无需改成机器人的绝对路径。
PEOPLE_COUNTER_MODEL_PATH=person_counter/models/yolo26n.onnx
PEOPLE_COUNTER_REGIONS_FILE=person_counter/glass_region.json
PEOPLE_COUNTER_MACHINE_AREAS_FILE=person_counter/machine_areas.json
# 只适用于原机位；其他摄像头请将 REGIONS_FILE 留空或更换标定。
PEOPLE_COUNTER_THREADS=2
PEOPLE_COUNTER_CONFIDENCE=0.25
PEOPLE_COUNTER_IMAGE_SIZE=640
PEOPLE_COUNTER_CAPTURE_INTERVAL=5
PEOPLE_COUNTER_HTTP_TIMEOUT=40
PEOPLE_COUNTER_NMS_IOU=0.50
PEOPLE_COUNTER_COMMAND_PRIORITY=10

# 示例插件仅允许 NoneBot 超级用户调用。
# 在机器人现有配置中设置 SUPERUSERS，例如：["你的用户ID"]。
# COMMAND_START 沿用机器人的现有配置。
